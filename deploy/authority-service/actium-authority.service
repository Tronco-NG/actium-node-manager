[Unit]
Description=Actium Authority Service (Trust Fabric)
After=network.target
Documentation=https://github.com/Tronco-NG/actium-node-manager

[Service]
Type=simple
User=actium-authority
Group=actium-authority
WorkingDirectory=/var/lib/actium/authority
ExecStart="/usr/lib/Actium Node Manager/authority/actium-authority-service"
Environment=ACTIUM_AUTHORITY_LISTEN=127.0.0.1:19443
Environment=ACTIUM_ENVIRONMENT=lab
Environment=ACTIUM_AUTHORITY_KEY_DIR=/var/lib/actium/authority/keys
Environment=ACTIUM_AUTHORITY_SEALING_KEY_FILE=/etc/actium/authority/sealing.key
Environment=ACTIUM_AUTHORITY_TRUST_BUNDLE_FILE=/var/lib/actium/authority/trust-bundle.json
# Center Local authenticates as a machine service through a protected token
# readable only by the Authority service account. Owner JWTs are never used
# as standing service credentials.
Environment=ACTIUM_AUTHORITY_SERVICE_TOKEN_FILE=/etc/actium/authority/center-local.token
Environment=ACTIUM_AUTHORITY_SERVICE_EXPECTED_CLIENT_ID=center
Restart=on-failure
RestartSec=2s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/actium/authority
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
