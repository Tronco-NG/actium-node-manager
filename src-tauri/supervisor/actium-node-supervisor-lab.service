[Unit]
Description=Actium Node Supervisor Lab
Documentation=file:/usr/share/doc/actium-node-supervisor/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/actium/node-manager-lab/actium-node-supervisor --config /etc/actium/node-manager-lab/supervisor.toml
Restart=on-failure
RestartSec=3s
RuntimeDirectory=actium
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
UMask=0077
Environment=DOCKER_CONFIG=/var/lib/actium/node-manager-lab/docker-cli
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/actium /var/lib/actium/node-manager-lab /var/lib/actium/node-manager/identity /var/lib/actium/node-manager/authority-lock /var/lib/actium/authority /var/lib/actium/authority-lab /var/log/actium/node-manager-lab /etc/actium/authority-lab /srv/actium-data/authority-offline-root /srv/actium-data/authority-recovery /etc/systemd/system/actium-node-supervisor-lab.service.d /actium-lab

[Install]
WantedBy=multi-user.target
