{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.actium.local/workload/v1/actium-workload-deployment-receipt.schema.json",
  "title": "Actium Workload Deployment Receipt v1",
  "description": "Observed convergence of a generic workload. Overall READY requires every component READY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deploymentId",
    "profileId",
    "profileVersion",
    "generation",
    "phase",
    "overall",
    "components",
    "observedAt"
  ],
  "properties": {
    "schema": { "const": "actium-workload-deployment-receipt@1.0.0" },
    "deploymentId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "profileVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "generation": { "type": "integer", "minimum": 0 },
    "phase": {
      "enum": ["DESIRED", "PLAN", "PREPARE", "INSTALL", "START", "HEALTH", "READY", "ROLLBACK"]
    },
    "overall": { "enum": ["PENDING", "READY", "DEGRADED", "FAILED", "STOPPED"] },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "status"],
        "properties": {
          "componentId": { "type": "string", "minLength": 1, "maxLength": 80 },
          "status": { "enum": ["PENDING", "READY", "DEGRADED", "FAILED", "STOPPED"] }
        }
      }
    },
    "observedAt": { "type": "string", "minLength": 1, "maxLength": 40 }
  }
}
