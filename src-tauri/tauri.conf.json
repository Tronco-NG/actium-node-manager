{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actium Node Manager",
  "version": "0.7.0-rc.3",
  "identifier": "com.actium.node-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Actium Node Manager",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Administra nodos Actium mediante Actium Node Supervisor.",
    "longDescription": "Instala, configura, amplia y verifica nodos Actium nuevos con ejecucion privilegiada aislada en Actium Node Supervisor.",
    "resources": {
      "resources/supervisor/": "supervisor/",
      "resources/install-dependencies-debian.sh": "install-dependencies-debian.sh",
      "resources/install-dependencies-windows.ps1": "install-dependencies-windows.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "supervisor/nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "systemd",
          "curl",
          "ca-certificates",
          "openssl",
          "iproute2",
          "docker.io",
          "docker-compose"
        ],
        "section": "admin",
        "postInstallScript": "supervisor/postinst-debian.sh"
      }
    }
  }
}
