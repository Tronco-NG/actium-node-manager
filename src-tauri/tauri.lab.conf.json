{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actium Node Manager Lab",
  "version": "0.7.0-lab.17",
  "identifier": "com.actium.node-manager.lab",
  "build": {
    "devUrl": "http://localhost:1438"
  },
  "app": {
    "windows": [
      {
        "title": "Actium Node Manager Lab"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "shortDescription": "Administra nodos Actium aislados en el canal Lab.",
    "longDescription": "Variante de laboratorio de Actium Node Manager con registro, rutas y namespace Docker aislados.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
