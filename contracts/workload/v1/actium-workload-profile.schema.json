{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.actium.local/workload/v1/actium-workload-profile.schema.json",
  "title": "Actium Workload Profile v1",
  "description": "Declarative immutable profile of a generic OCI workload. Native Actium capabilities stay outside this contract. Product-specific names belong to later adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "profileVersion",
    "runtimeKind",
    "architecture",
    "components",
    "secretRequirements",
    "healthChecks",
    "readinessChecks",
    "upgradePolicy",
    "rollbackPolicy"
  ],
  "properties": {
    "schema": { "const": "actium-workload-profile@1.0.0" },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profileVersion": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runtimeKind": { "enum": ["OCI_CONTAINER", "OCI_COMPOSE", "VM"] },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["amd64", "arm64"] }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeComponent" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/workloadModule" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "volumes": {
      "type": "array",
      "items": { "$ref": "#/$defs/persistentVolumeClaim" }
    },
    "networks": {
      "type": "array",
      "items": { "$ref": "#/$defs/networkAttachment" }
    },
    "ports": {
      "type": "array",
      "items": { "$ref": "#/$defs/port" }
    },
    "secretRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/secretRequirement" }
    },
    "healthChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/probe" }
    },
    "readinessChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/probe" }
    },
    "resources": { "$ref": "#/$defs/resourcePolicy" },
    "upgradePolicy": { "$ref": "#/$defs/upgradePolicy" },
    "rollbackPolicy": { "$ref": "#/$defs/rollbackPolicy" }
  },
  "$defs": {
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "image", "imageDigest", "network", "restartPolicy", "healthCheck"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "image": { "type": "string", "minLength": 1, "maxLength": 240 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "command": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "healthCheck": { "$ref": "#/$defs/probe" },
        "resources": { "$ref": "#/$defs/componentResources" },
        "volumes": { "type": "array", "items": { "type": "string" } },
        "network": { "enum": ["ISOLATED", "SITE_INTERNAL", "PRODUCT_INTERNAL", "PUBLIC_HTTPS"] },
        "restartPolicy": { "enum": ["no", "always", "on-failure", "unless-stopped"] }
      }
    },
    "workloadModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "required", "dependsOn", "conflictsWith"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "required": { "type": "boolean" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "conflictsWith": { "type": "array", "items": { "type": "string" } },
        "installStrategy": { "type": "string", "maxLength": 80 },
        "migrationStrategy": { "type": "string", "maxLength": 80 },
        "healthChecks": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
        "capabilitiesProvided": { "type": "array", "items": { "type": "string" } }
      }
    },
    "persistentVolumeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "size"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 80 },
        "size": { "type": "string", "minLength": 1, "maxLength": 32 },
        "storageClass": { "enum": ["local-disk", "nas-volume", "zfs-dataset", "remote-block", "cloud-volume"] },
        "backupPolicy": { "type": "string", "maxLength": 80 },
        "retentionPolicy": { "type": "string", "maxLength": 80 }
      }
    },
    "networkAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "policy"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "policy": { "enum": ["ISOLATED", "SITE_INTERNAL", "PRODUCT_INTERNAL", "PUBLIC_HTTPS"] }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "containerPort", "policy"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "policy": { "enum": ["ISOLATED", "SITE_INTERNAL", "PRODUCT_INTERNAL", "PUBLIC_HTTPS"] }
      }
    },
    "secretRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretId", "purpose"],
      "properties": {
        "secretId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scope": { "enum": ["deployment", "component", "host"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["http", "tcp", "exec", "none"] },
        "componentId": { "type": "string" },
        "path": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "componentResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuMin": { "type": "string" },
        "cpuMax": { "type": "string" },
        "memoryMin": { "type": "string" },
        "memoryMax": { "type": "string" },
        "diskMin": { "type": "string" }
      }
    },
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuMin": { "type": "string" },
        "cpuMax": { "type": "string" },
        "memoryMin": { "type": "string" },
        "memoryMax": { "type": "string" },
        "diskMin": { "type": "string" }
      }
    },
    "upgradePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "requiresSnapshot", "databaseMigration", "rollbackCompatibility"],
      "properties": {
        "strategy": { "enum": ["replace", "rolling", "prepare-switch"] },
        "requiresSnapshot": { "type": "boolean" },
        "databaseMigration": { "enum": ["none", "forward", "forward-irreversible"] },
        "rollbackCompatibility": { "enum": ["runtime-only", "runtime-and-database", "none"] }
      }
    },
    "rollbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeRollback", "databaseRollback"],
      "properties": {
        "runtimeRollback": { "enum": ["previous-profile", "previous-generation", "none"] },
        "databaseRollback": { "enum": ["previous-snapshot", "none"] }
      }
    }
  }
}
