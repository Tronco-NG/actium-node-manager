[Unit]
Description=Actium Node Supervisor
Documentation=file:/usr/share/doc/actium-node-supervisor/README.md
Requires=docker.service
Wants=actium-authority.service network-online.target
After=actium-authority.service docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=actium-authority
WorkingDirectory=/var/lib/actium/node-manager
ExecStart="/usr/lib/Actium Node Manager/supervisor/actium-node-supervisor" service-launch --environment stable
Restart=on-failure
RestartSec=3s
RuntimeDirectory=actium
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
UMask=0077
Environment=DOCKER_CONFIG=/var/lib/actium/node-manager/docker-cli
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/actium /var/lib/actium/node-manager /var/lib/actium/node-manager/authority-lock /var/lib/actium/authority /var/log/actium/node-manager /etc/actium/authority /srv/actium-data/authority-offline-root /srv/actium-data/authority-recovery /etc/systemd/system/actium-node-supervisor.service.d /actium

[Install]
WantedBy=multi-user.target
