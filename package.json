{
  "name": "actium-node-manager",
  "private": true,
  "version": "0.7.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:storage-gate-1-5": "node --test scripts/storage-gate-1-5-contract.test.mjs",
    "test:host-binding-phase-3": "node --test scripts/host-binding-phase-3-contract.test.mjs",
    "test:host-enrollment-gate-1-6-2": "node --test scripts/host-enrollment-gate-1-6-2-deploy-contract.test.mjs",
    "test:contracts-m2": "node --experimental-strip-types --test scripts/contracts-m2.test.mjs",
    "test:base-runtime-m2-1": "node --test scripts/base-runtime-m2-1.test.mjs",
    "test:host-readiness-correctness": "node --test scripts/host-readiness-correctness.test.mjs",
    "test:storage-phase-4": "node --test scripts/storage-phase-4-contract.test.mjs",
    "test:storage-phase-5": "node --test scripts/storage-phase-5-contract.test.mjs",
    "test:capability-surface": "node --experimental-strip-types --test scripts/capability-surface.test.mjs",
    "test:escape-regexp": "node --test scripts/escape-regexp.test.mjs",
    "test:attestation-authority": "cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib attestation::tests --no-default-features && cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib releases::tests --no-default-features && cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib runtime::tests --no-default-features",
    "test:attestation-stress": "cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib attestation::tests::miles_de_records_compactan_y_head_permanece_o1 --no-default-features",
    "test:attestation-recovery": "cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib attestation::tests::compactacion_es_recuperable_en_cada_frontera_de_crash --no-default-features && cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib attestation::tests::reloj_retrogrado_nunca_extiende_frescura_material --no-default-features && cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --lib attestation::tests::prueba_transportable_liga_envelope_record_y_genesis --no-default-features",
    "verify:durable-state": "cargo run --manifest-path src-tauri/Cargo.toml -p actium-node-core --example verify-durable-state",
    "test:promotion-faults": "cargo test --manifest-path src-tauri/Cargo.toml -p actium-node-core --features fault-injection fault_injection_cierra_first_install_upgrade_y_fabric",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:lab": "tauri dev --config src-tauri/tauri.lab.conf.json",
    "tauri:build:lab": "tauri build --config src-tauri/tauri.lab.conf.json",
    "tauri:dev:stable": "tauri dev",
    "compile": "node scripts/build-master.mjs",
    "build:installer": "node scripts/build-master.mjs",
    "supervisor:build:linux": "node scripts/build-supervisor-linux.mjs",
    "supervisor:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-supervisor-windows.ps1 -Channel lab",
    "supervisor:build:windows:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-supervisor-windows.ps1 -Channel stable"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
